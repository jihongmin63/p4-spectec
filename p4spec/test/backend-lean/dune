(executable
 (name print_diff)
 (modules print_diff)
 (libraries pass p4 runtime diagnostic util lang bignum.bigint))

(executable
 (name builtin_oracle)
 (modules builtin_oracle)
 (libraries builtin runtime util domain lang bignum.bigint))

(rule
 (target builtin_oracle.actual)
 (action
  (with-stdout-to builtin_oracle.actual
   (run %{exe:builtin_oracle.exe}))))

(rule
 (alias backend-lean)
 (deps builtin_oracle.actual)
 (action
  (diff builtin_oracle.expected builtin_oracle.actual)))

(rule
 (target set.lean)
 (deps set.watsup set-proof.lean)
 (action
  (with-stdout-to set.lean
   (progn
    (run %{exe:../../lib/lean-skeleton/main.exe} %{dep:set.watsup})
    (cat %{dep:set-proof.lean})))))

(rule
 (alias backend-lean)
 (deps set.lean)
 (action (run lean set.lean)))

(rule
 (target set-nontext.actual)
 (deps set-nontext.watsup)
 (action
  (with-stderr-to set-nontext.actual
   (with-accepted-exit-codes 1
    (run
     %{exe:../../lib/lean-skeleton/main.exe}
     %{dep:set-nontext.watsup})))))

(rule
 (alias backend-lean)
 (deps set-nontext.actual)
 (action
  (diff set-nontext.expected set-nontext.actual)))

