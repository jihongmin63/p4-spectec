(executable
 (name print_diff)
 (modules print_diff)
 (libraries pass p4 runtime diagnostic util lang bignum.bigint))

(executable
 (name builtin_oracle)
 (modules builtin_oracle)
 (libraries builtin runtime util domain lang bignum.bigint))

(executable
 (name fresh_interp)
 (modules fresh_interp)
 (libraries p4spectec runtime interface diagnostic bignum.bigint))

(rule
 (target fresh-interp.actual)
 (deps fresh.watsup)
 (action
  (with-stdout-to fresh-interp.actual
   (run %{exe:fresh_interp.exe} %{dep:fresh.watsup}))))

(rule
 (alias backend-lean)
 (deps fresh-interp.actual)
 (action (diff fresh-interp.expected fresh-interp.actual)))

