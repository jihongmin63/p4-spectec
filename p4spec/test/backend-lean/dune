(rule
 (target case-obligations.actual)
 (deps case-obligation.watsup case-empty.p4 case-semicolon.p4 case-oracle.lean)
 (action
  (with-stdout-to case-obligations.actual
   (run %{exe:../../lib/lean-skeleton/main.exe}
    --obligations-only
    --case %{dep:case-empty.p4} %{dep:case-oracle.lean}
    --reject-case %{dep:case-semicolon.p4}
    %{dep:case-obligation.watsup}))))

(rule
 (alias backend-lean)
 (deps case-obligations.actual)
 (action (diff case-obligations.expected case-obligations.actual)))

(rule
 (target case-obligation.lean)
 (deps case-obligation.watsup case-empty.p4 case-semicolon.p4 case-oracle.lean)
 (action
  (with-stdout-to case-obligation.lean
   (run %{exe:../../lib/lean-skeleton/main.exe}
    --case %{dep:case-empty.p4} %{dep:case-oracle.lean}
    --reject-case %{dep:case-semicolon.p4}
    %{dep:case-obligation.watsup}))))

(rule
 (alias backend-lean)
 (deps case-obligation.lean)
 (action (run lean case-obligation.lean)))

