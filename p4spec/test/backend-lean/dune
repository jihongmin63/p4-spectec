(rule
 (target fresh-reset.actual)
 (deps
  check_fresh_reset.py
  (source_tree ../../../spec)
  (source_tree ../../../p4c/p4include)
  ../../../p4c/testdata/p4_16_samples/type-params.p4
  ../../../p4c/testdata/p4_16_samples/extern2.p4)
 (action
  (with-stdout-to fresh-reset.actual
   (run python3 %{dep:check_fresh_reset.py}
    --exe %{exe:../../lib/lean-skeleton/main.exe}
    --spec ../../../spec --include ../../../p4c/p4include
    --first %{dep:../../../p4c/testdata/p4_16_samples/type-params.p4}
    --middle %{dep:../../../p4c/testdata/p4_16_samples/extern2.p4}))))

(rule
 (alias backend-lean)
 (deps fresh-reset.actual)
 (action (diff fresh-reset.expected fresh-reset.actual)))
