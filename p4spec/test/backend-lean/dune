
(rule
 (target ordered-fresh-runtime.lean)
 (deps ../../lib/lean-skeleton/lean/SpecTecExecution.lean ordered-fresh-runtime-proof.lean)
 (action
  (with-stdout-to ordered-fresh-runtime.lean
   (progn (cat %{dep:../../lib/lean-skeleton/lean/SpecTecExecution.lean})
          (cat %{dep:ordered-fresh-runtime-proof.lean})))))

(rule
 (alias backend-lean)
 (deps ordered-fresh-runtime.lean)
 (action (run lean ordered-fresh-runtime.lean)))

