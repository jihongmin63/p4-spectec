syntax p4program =
  | _EMPTY
  | p4program ';'

syntax typeId = text
builtin dec $fresh_typeId() : typeId
var tid : typeId

dec $pick() : typeId
def $pick() = "unreachable"
  -- if $fresh_typeId() = "never"
def $pick() = $fresh_typeId()

syntax p4programIR = RESULT typeId typeId text

relation Program_ok:
  |- p4program : p4programIR
  hint(input %0)

rule Program_ok/empty:
  |- _EMPTY : RESULT tid tid "FRESH__99"
  -- if tid = $pick()
