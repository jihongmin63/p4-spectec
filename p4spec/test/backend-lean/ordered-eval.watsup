syntax value = ZERO | ONE | WRAP value

var v : value

relation Gate:
  |- value
  hint(input %0)

rule Gate/zero:
  |- ZERO

dec $ordered(value) : value
def $ordered(ZERO) = ZERO
def $ordered(WRAP v) = ZERO
  -- Gate: |- ONE
def $ordered(WRAP v) = ONE
def $ordered(v) = v
  -- otherwise

relation PositiveLoop:
  |- value
  hint(input %0)

rule PositiveLoop/wrap:
  |- WRAP v
  -- PositiveLoop: |- v

relation NegativeLoop:
  |- value
  hint(input %0)

rule NegativeLoop/not_self:
  |- ZERO
  -- NegativeLoop:/ |- ZERO

;; A polymorphic rule without binders leaves no term from which Lean can infer
;; the explicit type argument to its generated premise list.
dec $generic_option<X>(X?) : bool
def $generic_option<X>(eps) = false
def $generic_option<X>(X) = true

;; The first rule binder deliberately shadows a global type used by the second
;; binder.  Generated evaluator certificates must qualify that type.
syntax shadow = SHADOW
syntax shadowList =
  | _EMPTY
  | shadowList shadow

dec $flatten_shadowList(shadowList) : shadow*
def $flatten_shadowList(_EMPTY) = eps
def $flatten_shadowList(shadowList shadow)
  = $flatten_shadowList(shadowList) ++ [ shadow ]
