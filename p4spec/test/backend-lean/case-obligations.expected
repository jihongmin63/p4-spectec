namespace SpecTec

-- case_0: "./case-empty.p4"
def case_0_input : p4program := (@p4program._EMPTY)
def case_0_expected : p4programIR := (@p4programIR.OK)
def case_0_fresh_names : List String := []
def case_0_protected_names : List String := []
def case_0 : Prop := (∃ output : p4programIR, Program_ok case_0_input output ∧
    FreshAlphaIR case_0_fresh_names case_0_protected_names case_0_expected output) ∧
  ∀ output : p4programIR, Program_ok case_0_input output → FreshAlphaIR case_0_fresh_names case_0_protected_names case_0_expected output

-- case_1: "./case-semicolon.p4"
def case_1_input : p4program := (@p4program.«% ';'» (@p4program._EMPTY))
def case_1 : Prop := ¬ (∃ output : p4programIR, Program_ok case_1_input output)

end SpecTec
